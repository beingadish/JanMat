# Base URL the browser uses to reach the API.
# Default is "/api", which is proxied to janmat-api by:
#   - the Vite dev server (see vite.config.ts), and
#   - nginx in the production/Docker image (see nginx.conf).
# Only change this if you want the browser to hit the backend directly
# (that would require CORS to be enabled on janmat-api).
VITE_API_BASE_URL=/api

# Dev-only: where the Vite dev server proxies /api to.
# VITE_DEV_API_TARGET=http://127.0.0.1:3000
